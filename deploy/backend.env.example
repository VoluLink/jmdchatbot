# FastAPI backend environment
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-5-mini

# Chroma (adjust paths to your server)
CHROMA_DB_DIR=/opt/jmdchatbot/data/chroma
INDEX_NAME=rag_seminararbeit
LOCAL_DATA_DIR=/opt/jmdchatbot/data/sources

# Optional
CHUNK_SIZE=1024
CHUNK_OVERLAP=200

# Frontend origin(s) allowed for browser requests to FastAPI
# Comma-separated list, e.g. http://116.203.166.18:3000,https://jmdchatbot.kjf-regensburg.de
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
