# App + Postgres (production)
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rag_auth
DATABASE_URL=postgresql://rag_user:change-me@postgres:5432/rag_auth
JWT_SECRET=change-me-very-long-secret
FRONTEND_URL=https://example.com

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=RAG Assistant
PASSWORD_RESET_EXPIRY_MINUTES=60

# Where the frontend should reach the backend
# If you use Caddy to proxy /query, set this to https://example.com
NEXT_PUBLIC_API_BASE_URL=https://example.com
