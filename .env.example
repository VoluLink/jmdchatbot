# ============================================================================
# Database Configuration
# ============================================================================

# PostgreSQL connection string (for production/Docker)
# If not set, SQLite will be used automatically for local development
# SQLite database will be created at: data/local.db
DATABASE_URL=postgresql://rag_user:rag_password@localhost:5432/rag_auth

# Backend API (FastAPI) base URL for the chat UI
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Frontend URL (used for invite/reset links)
FRONTEND_URL=http://localhost:3000

BACKEND_API_BASE_URL=http://host.docker.internal:8000

# ============================================================================
# OpenAI Configuration
# ============================================================================

# OpenAI API Key (required for LLM features)
OPENAI_API_KEY=sk-proj-...your-key-here...

# OpenAI model (optional, default: gpt-5-mini)
OPENAI_MODEL=gpt-5-mini

# ============================================================================
# Vector Store Configuration
# ============================================================================

# ChromaDB index name (optional, default: rag_seminararbeit)
INDEX_NAME=rag_seminararbeit

# ChromaDB directory (optional, default: data/chroma)
CHROMA_DB_DIR=data/chroma

# ============================================================================
# Document Ingestion Configuration
# ============================================================================

# Local data directory (optional, default: data/sources)
LOCAL_DATA_DIR=data/sources

# Chunking parameters (optional)
CHUNK_SIZE=1024
CHUNK_OVERLAP=200

# URLs for automatic updates (optional, JSON list)
# Example: SOURCE_URLS=["https://example.com/api/laws","https://another.com/docs"]
SOURCE_URLS=[]

