# ============================================================================
# RAG Seminararbeit - Environment Variables
# ============================================================================
# Copy this file to .env and fill in your actual values
# ============================================================================

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Database & Storage Paths (relative to project root)
# These are the defaults - only change if you need custom paths
# DATA_DIR=data
# CHROMA_DB_DIR=data/chroma
# LOCAL_DATA_DIR=data/sources

# Index Configuration
INDEX_NAME=rag_index

# Chunking Configuration
CHUNK_SIZE=1024
CHUNK_OVERLAP=100

# Web Sources (optional - comma-separated URLs)
# SOURCE_URLS=https://example.com/doc1,https://example.com/doc2

# Server Configuration (for local development)
# HOST=0.0.0.0
# PORT=8000

# CORS Configuration (for frontend)
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================================================
# Email Configuration (Gmail SMTP)
# ============================================================================
# For Gmail:
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Create an "App Password" for your application
# 3. Use that password here (not your regular Gmail password)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=RAG Assistant

# Password Reset Configuration
PASSWORD_RESET_EXPIRY_MINUTES=60

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000

# ============================================================================
# Development Settings (optional)
# ============================================================================

# Logging
# LOG_LEVEL=INFO

# Debug Mode
# DEBUG=false

